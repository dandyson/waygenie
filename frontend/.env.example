# Copy to .env for local development: cp .env.example .env

# Auth0 tenant domain, e.g. dev-xxxx.uk.auth0.com
# (Auth0 dashboard > Applications > your SPA > Settings > Domain)
VITE_AUTH0_DOMAIN=

# Auth0 SPA Client ID
# (Auth0 dashboard > Applications > your SPA > Settings > Client ID)
VITE_AUTH0_CLIENT_ID=

# Auth0 API identifier - must match `audience` in backend/middleware/auth.js
VITE_AUTH0_AUDIENCE=

# Backend base URL, no trailing slash
# Local: http://localhost:5000   Production: the Railway public URL
VITE_API_URL=

# Where Auth0 sends the user after logout
# Local: http://localhost:3000   Production: the Cloudflare Pages URL
VITE_FRONTEND_URL=
