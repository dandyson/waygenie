# Copy to .env for local development: cp .env.example .env
# Create React App inlines every REACT_APP_* value into the public JS bundle at
# build time, so NEVER put secrets here. Restart `npm start` after editing.
# In production these are set in the Cloudflare Pages dashboard
# (Workers & Pages > project > Settings > Variables and Secrets).

# Auth0 tenant domain, e.g. dev-xxxx.uk.auth0.com
# (Auth0 dashboard > Applications > your SPA > Settings > Domain)
REACT_APP_AUTH0_DOMAIN=

# Auth0 SPA Client ID
# (Auth0 dashboard > Applications > your SPA > Settings > Client ID)
REACT_APP_AUTH0_CLIENT_ID=

# Auth0 API identifier - must match `audience` in backend/middleware/auth.js
REACT_APP_AUTH0_AUDIENCE=

# Backend base URL, no trailing slash
# Local: http://localhost:5000   Production: the Railway public URL
REACT_APP_API_URL=

# Where Auth0 sends the user after logout
# Local: http://localhost:3000   Production: the Cloudflare Pages URL
REACT_APP_FRONTEND_URL=
