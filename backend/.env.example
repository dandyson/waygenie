# Copy to .env for local development: cp .env.example .env
# In production these are set in the Railway dashboard.
# The Auth0 domain and audience are hardcoded in middleware/auth.js, so the
# backend needs no Auth0 variables.

# OpenAI API key (secret - never commit the real value)
OPENAI_API_KEY=

# Redis connection URL used by the BullMQ job queue
# Local: redis://localhost:6379   Production: the Redis Cloud URL
REDISCLOUD_URL=

# Frontend origin allowed by CORS (http://localhost:3000 is always allowed)
# Production: the Cloudflare Pages URL
FRONTEND_URL=

# Optional - defaults to 5000
PORT=
